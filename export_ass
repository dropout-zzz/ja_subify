@dataclass
class AssLine:
  text: str

  # whether or not should use the Rubi style
  is_rubi: bool = False

  # coordinates in pixels
  x: float = 0.0
  y: float = 0.0

class LayoutObject(ABC):
  """an object that take a rectangular space."""

  @abstractmethod
  def to_ass(self) -> list[AssLine]:
    """return list of ASS lines needed to render contents in this layout object.
       coordinates are relative to top-left corner of rect of this layout object.

       this function assumes the global position of top-left corner of this layout object is at (0, 0)."""

  def get_advance(self) -> float:
    """return x offset suitable for placing next layout object.
       this is width plus extra post spacing."""
    return self.get_width()

  @abstractmethod
  def get_width(self) -> float:
    """return logical width, without extra spacings on each end."""

  @abstractmethod
  def get_height(self) -> float:
    pass

  def get_pre_spacing(self) -> float:
    """extra spacing that should be added before placing this layout object when layouting."""
    return 0.0

@dataclass
class LayouterContext:
  """a wrapper class
     making it easy to pass all these in one argument."""

  os2: TT_OS2
  font_size: int
  rubi_font_size: int
  fm: QFontMetrics

_ASCII_SPC = ' '

class SimpleTextObject(LayoutObject):
  """simplest case containing exactly just one text."""

  def __init__(self, ctx: LayouterContext, text: str, is_rubi: bool = False):
    assert text != '', '???'
    self.__ctx = ctx
    self.__is_rubi = is_rubi
    self.__width = self.__measure_text(text)
    assert self.__width > 0, '???'
    self.__text = text

  def __measure_text(self, s: str) -> float:
    # font size value in ASS means ascender plus descender in pixels, not the pixel size of EM square.
    # another catch is it always uses ascender and descender sizes from OS/2 table.
    #
    # note that we have previously configured QFontMetrics to return us values in font units instead of in pixels.
    #
    # this formula is simple: Qt does shaping and return us advance value in font units,
    #                          then we find out how many ascender plus descender is in that,
    #                          since ASS font size means ascender plus descender in pixels,
    #                          if we then multiply it with the ASS font size value we get the advance value in pixels.
    #
    # this is a bit neat because we can use a single QFont but re-use it to measure using as many as different font sizes we want.
    #
    # we have been keeping all values in integers until this single division step, so accuracy here should be best-effort.
    #
    # XXX: using Qt to shape seem to return a slightly different result compared to HarfBuzz... (sub-pixel difference)
    return (self.__ctx.fm.horizontalAdvance(s) * (self.__ctx.rubi_font_size if self.__is_rubi else self.__ctx.font_size)) / (self.__ctx.os2.usWinAscent + self.__ctx.os2.usWinDescent)

  def get_text(self) -> str:
    return self.__text

  @override
  def to_ass(self) -> list[AssLine]:
    """we don't render each characters separately, this saves us output file size and
        avoids problem like outline collisions when the text is too small and are too close to each others (e.g. Rubi)
       this is similar to what Aegisub's karaoke templater produces."""

    ass_lines = [AssLine(text=self.__text, is_rubi=self.__is_rubi)]

    no_leading_spc = self.__text.lstrip(_ASCII_SPC)
    if no_leading_spc != self.__text:
      # ASS doesn't like leading/trailing spaces and ignores them completely
      # for leading spaces we must fixup by shifting text position to the right
      n_leading_spc = len(self.__text) - len(no_leading_spc)
      shift_ass_lines(ass_lines, self.__measure_text(_ASCII_SPC * n_leading_spc), 0.0)

    return ass_lines

  @override
  def get_width(self) -> float:
    return self.__width

  @override
  def get_height(self) -> float:
    if self.__is_rubi:
      return float(self.__ctx.rubi_font_size)

    return float(self.__ctx.font_size)

def shift_ass_lines(ass_lines: list[AssLine], delta_x: float, delta_y: float) -> list[AssLine]:
  for ass_line in ass_lines:
    ass_line.x += delta_x
    ass_line.y += delta_y
  return ass_lines

