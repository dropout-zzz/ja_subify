  FC_FILE,
  FcPatternGetString,
  FC_INDEX,
  FcPatternGetInteger,
)
from annotation_file import annotation_parse, PlainAnnotation, LoanAnnotation, KanjiAnnotation, AnnotationFile
from dropout_freetype import FT_Init_FreeType, FT_New_Face, FT_Sfnt_Tag, FT_Get_Sfnt_Table, TT_OS2
from PySide6.QtGui import QGuiApplication, QFont, QFontMetrics
